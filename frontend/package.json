{
  "name": "doc2data-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-pdf-worker": "node -e \"const fs=require('fs'),path=require('path');try{const src='node_modules/pdfjs-dist/build/pdf.worker.min.mjs';if(!fs.existsSync(src)){console.log('[copy-pdf-worker] skip (dep not installed yet)');process.exit(0)}fs.mkdirSync('public',{recursive:true});fs.copyFileSync(src,'public/pdf.worker.min.mjs');console.log('[copy-pdf-worker] ok')}catch(e){console.log('[copy-pdf-worker] skip:',e.message)}\"",
    "dev": "npm run copy-pdf-worker && next dev -p 3000",
    "build": "npm run copy-pdf-worker && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "14.2.18",
    "pdfjs-dist": "^4.4.168",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pdf": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.18",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3"
  }
}
